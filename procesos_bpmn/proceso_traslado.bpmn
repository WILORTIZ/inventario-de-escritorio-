<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_Traslado"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Antigravity BPMN Modeler"
                  exporterVersion="1.0.0">
  <bpmn:collaboration id="Collaboration_Traslado">
    <bpmn:participant id="Participant_ProcesoTraslado" name="Proceso de Traslado entre Bodegas (Inventario CDS)" processRef="Process_Traslado" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Traslado" name="Traslado de Inventario entre Bodegas" isExecutable="true">
    <bpmn:laneSet id="LaneSet_Traslado">
      <bpmn:lane id="Lane_BodegaDestino" name="Bodega Destino / Solicitante">
        <bpmn:flowNodeRef>StartEvent_RequerimientoTraslado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_SolicitarTraslado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_RecibirVerificarCarga</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ConformidadTraslado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_RegistrarDiscrepancia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_UbicacionDestino</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_BodegaOrigen" name="Operador Bodega Origen">
        <bpmn:flowNodeRef>Activity_ValidarStockOrigen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_StockOrigenOK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_CanceladoSinStock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_PickingDespacho</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SistemaCDS_Tras" name="Sistema de Inventario CDS">
        <bpmn:flowNodeRef>Activity_RegistrarSalidaTraslado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_ConfirmarRecepcionDestino</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_TrasladoCompletado</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Flujo Inicio -->
    <bpmn:startEvent id="StartEvent_RequerimientoTraslado" name="Necesidad de Reabastecimiento">
      <bpmn:outgoing>Flow_T1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Activity_SolicitarTraslado" name="Crear Solicitud: Ítem, Cantidad, Bodega Origen y Destino">
      <bpmn:incoming>Flow_T1</bpmn:incoming>
      <bpmn:outgoing>Flow_T2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Bodega Origen -->
    <bpmn:serviceTask id="Activity_ValidarStockOrigen" name="Consultar Existencias en Bodega Origen">
      <bpmn:incoming>Flow_T2</bpmn:incoming>
      <bpmn:outgoing>Flow_T3</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_StockOrigenOK" name="¿Stock Disponible en Origen?">
      <bpmn:incoming>Flow_T3</bpmn:incoming>
      <bpmn:outgoing>Flow_StockOrigNo</bpmn:outgoing>
      <bpmn:outgoing>Flow_StockOrigSi</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="EndEvent_CanceladoSinStock" name="Traslado Cancelado / Notificar a Destino">
      <bpmn:incoming>Flow_StockOrigNo</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:userTask id="Activity_PickingDespacho" name="Picking, Rotulación y Preparación de Guía de Traslado">
      <bpmn:incoming>Flow_StockOrigSi</bpmn:incoming>
      <bpmn:outgoing>Flow_T4</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Sistema CDS Registro Despacho -->
    <bpmn:serviceTask id="Activity_RegistrarSalidaTraslado" name="Registrar Movimiento 'TRASLADO' (↔) Descuenta en Origen">
      <bpmn:incoming>Flow_T4</bpmn:incoming>
      <bpmn:outgoing>Flow_T5</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Recepción Destino -->
    <bpmn:userTask id="Activity_RecibirVerificarCarga" name="Recepción Física y Conteo Cuantitativo en Destino">
      <bpmn:incoming>Flow_T5</bpmn:incoming>
      <bpmn:outgoing>Flow_T6</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_ConformidadTraslado" name="¿Carga Conforme con Remisión?">
      <bpmn:incoming>Flow_T6</bpmn:incoming>
      <bpmn:outgoing>Flow_ConfNo</bpmn:outgoing>
      <bpmn:outgoing>Flow_ConfSi</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Activity_RegistrarDiscrepancia" name="Reportar Novedad / Ajuste por Discrepancia">
      <bpmn:incoming>Flow_ConfNo</bpmn:incoming>
      <bpmn:outgoing>Flow_T_Disc</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Activity_UbicacionDestino" name="Ubicar Material en Estantería de Bodega Destino">
      <bpmn:incoming>Flow_ConfSi</bpmn:incoming>
      <bpmn:incoming>Flow_T_Disc</bpmn:incoming>
      <bpmn:outgoing>Flow_T7</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="Activity_ConfirmarRecepcionDestino" name="Acreditar Saldo en Bodega Destino y Cerrar Traslado en Kardex">
      <bpmn:incoming>Flow_T7</bpmn:incoming>
      <bpmn:outgoing>Flow_T8</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvent_TrasladoCompletado" name="Traslado Inter-Bodegas Finalizado con Éxito">
      <bpmn:incoming>Flow_T8</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Secuencias de Flujo -->
    <bpmn:sequenceFlow id="Flow_T1" sourceRef="StartEvent_RequerimientoTraslado" targetRef="Activity_SolicitarTraslado" />
    <bpmn:sequenceFlow id="Flow_T2" sourceRef="Activity_SolicitarTraslado" targetRef="Activity_ValidarStockOrigen" />
    <bpmn:sequenceFlow id="Flow_T3" sourceRef="Activity_ValidarStockOrigen" targetRef="Gateway_StockOrigenOK" />
    <bpmn:sequenceFlow id="Flow_StockOrigNo" name="No" sourceRef="Gateway_StockOrigenOK" targetRef="EndEvent_CanceladoSinStock" />
    <bpmn:sequenceFlow id="Flow_StockOrigSi" name="Sí" sourceRef="Gateway_StockOrigenOK" targetRef="Activity_PickingDespacho" />
    <bpmn:sequenceFlow id="Flow_T4" sourceRef="Activity_PickingDespacho" targetRef="Activity_RegistrarSalidaTraslado" />
    <bpmn:sequenceFlow id="Flow_T5" sourceRef="Activity_RegistrarSalidaTraslado" targetRef="Activity_RecibirVerificarCarga" />
    <bpmn:sequenceFlow id="Flow_T6" sourceRef="Activity_RecibirVerificarCarga" targetRef="Gateway_ConformidadTraslado" />
    <bpmn:sequenceFlow id="Flow_ConfNo" name="No (Incompleto/Dañado)" sourceRef="Gateway_ConformidadTraslado" targetRef="Activity_RegistrarDiscrepancia" />
    <bpmn:sequenceFlow id="Flow_ConfSi" name="Sí (Conforme)" sourceRef="Gateway_ConformidadTraslado" targetRef="Activity_UbicacionDestino" />
    <bpmn:sequenceFlow id="Flow_T_Disc" sourceRef="Activity_RegistrarDiscrepancia" targetRef="Activity_UbicacionDestino" />
    <bpmn:sequenceFlow id="Flow_T7" sourceRef="Activity_UbicacionDestino" targetRef="Activity_ConfirmarRecepcionDestino" />
    <bpmn:sequenceFlow id="Flow_T8" sourceRef="Activity_ConfirmarRecepcionDestino" targetRef="EndEvent_TrasladoCompletado" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_Traslado">
    <bpmndi:BPMNPlane id="BPMNPlane_Traslado" bpmnElement="Collaboration_Traslado">
      <bpmndi:BPMNShape id="Participant_ProcesoTraslado_di" bpmnElement="Participant_ProcesoTraslado" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1440" height="540" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_BodegaDestino_di" bpmnElement="Lane_BodegaDestino" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="1410" height="170" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_BodegaOrigen_di" bpmnElement="Lane_BodegaOrigen" isHorizontal="true">
        <dc:Bounds x="190" y="250" width="1410" height="190" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_SistemaCDS_Tras_di" bpmnElement="Lane_SistemaCDS_Tras" isHorizontal="true">
        <dc:Bounds x="190" y="440" width="1410" height="180" />
      </bpmndi:BPMNShape>

      <!-- Elementos -->
      <bpmndi:BPMNShape id="StartEvent_RequerimientoTraslado_di" bpmnElement="StartEvent_RequerimientoTraslado">
        <dc:Bounds x="242" y="142" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="220" y="185" width="81" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_SolicitarTraslado_di" bpmnElement="Activity_SolicitarTraslado">
        <dc:Bounds x="330" y="120" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_ValidarStockOrigen_di" bpmnElement="Activity_ValidarStockOrigen">
        <dc:Bounds x="330" y="300" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_StockOrigenOK_di" bpmnElement="Gateway_StockOrigenOK" isMarkerVisible="true">
        <dc:Bounds x="515" y="315" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="498" y="278" width="84" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_CanceladoSinStock_di" bpmnElement="EndEvent_CanceladoSinStock">
        <dc:Bounds x="522" y="392" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="568" y="395" width="82" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_PickingDespacho_di" bpmnElement="Activity_PickingDespacho">
        <dc:Bounds x="630" y="300" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_RegistrarSalidaTraslado_di" bpmnElement="Activity_RegistrarSalidaTraslado">
        <dc:Bounds x="630" y="490" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_RecibirVerificarCarga_di" bpmnElement="Activity_RecibirVerificarCarga">
        <dc:Bounds x="820" y="120" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_ConformidadTraslado_di" bpmnElement="Gateway_ConformidadTraslado" isMarkerVisible="true">
        <dc:Bounds x="1005" y="135" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="987" y="105" width="86" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_RegistrarDiscrepancia_di" bpmnElement="Activity_RegistrarDiscrepancia">
        <dc:Bounds x="1090" y="175" width="130" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_UbicacionDestino_di" bpmnElement="Activity_UbicacionDestino">
        <dc:Bounds x="1260" y="120" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_ConfirmarRecepcionDestino_di" bpmnElement="Activity_ConfirmarRecepcionDestino">
        <dc:Bounds x="1260" y="490" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_TrasladoCompletado_di" bpmnElement="EndEvent_TrasladoCompletado">
        <dc:Bounds x="1462" y="512" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1438" y="555" width="84" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Conexiones -->
      <bpmndi:BPMNEdge id="Flow_T1_di" bpmnElement="Flow_T1">
        <di:waypoint x="278" y="160" />
        <di:waypoint x="330" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_T2_di" bpmnElement="Flow_T2">
        <di:waypoint x="395" y="200" />
        <di:waypoint x="395" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_T3_di" bpmnElement="Flow_T3">
        <di:waypoint x="460" y="340" />
        <di:waypoint x="515" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_StockOrigNo_di" bpmnElement="Flow_StockOrigNo">
        <di:waypoint x="540" y="365" />
        <di:waypoint x="540" y="392" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="548" y="370" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_StockOrigSi_di" bpmnElement="Flow_StockOrigSi">
        <di:waypoint x="565" y="340" />
        <di:waypoint x="630" y="340" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="591" y="322" width="12" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_T4_di" bpmnElement="Flow_T4">
        <di:waypoint x="695" y="380" />
        <di:waypoint x="695" y="490" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_T5_di" bpmnElement="Flow_T5">
        <di:waypoint x="760" y="530" />
        <di:waypoint x="790" y="530" />
        <di:waypoint x="790" y="160" />
        <di:waypoint x="820" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_T6_di" bpmnElement="Flow_T6">
        <di:waypoint x="950" y="160" />
        <di:waypoint x="1005" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ConfNo_di" bpmnElement="Flow_ConfNo">
        <di:waypoint x="1030" y="185" />
        <di:waypoint x="1030" y="205" />
        <di:waypoint x="1090" y="205" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1034" y="188" width="70" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ConfSi_di" bpmnElement="Flow_ConfSi">
        <di:waypoint x="1055" y="160" />
        <di:waypoint x="1260" y="160" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1120" y="142" width="75" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_T_Disc_di" bpmnElement="Flow_T_Disc">
        <di:waypoint x="1220" y="205" />
        <di:waypoint x="1240" y="205" />
        <di:waypoint x="1240" y="180" />
        <di:waypoint x="1260" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_T7_di" bpmnElement="Flow_T7">
        <di:waypoint x="1325" y="200" />
        <di:waypoint x="1325" y="490" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_T8_di" bpmnElement="Flow_T8">
        <di:waypoint x="1390" y="530" />
        <di:waypoint x="1462" y="530" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
